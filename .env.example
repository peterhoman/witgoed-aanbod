FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite:///witgoed.db

# Bol.com API
BOL_CLIENT_ID=your-bol-client-id
BOL_CLIENT_SECRET=your-bol-client-secret
BOL_PARTNER_ID=your-bol-partner-id

# MediaMarkt productfeed (Tradedoubler dashboard: Advertentie manager > Productfeeds)
TRADEDOUBLER_TOKEN=your-tradedoubler-token

# Coolblue productfeed (Awin dashboard: Hulpmiddelen > Create-a-Feed, apikey uit de download-URL)
AWIN_FEED_APIKEY=your-awin-feed-apikey

# Claude API
ANTHROPIC_API_KEY=your-claude-api-key

# Site config
SITE_NAME=WitgoedAanbod.nl
SITE_URL=https://witgoedaanbod.nl
